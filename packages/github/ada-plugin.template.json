{
  "format": 1,
  "id": "ada.theme-github",
  "name": "GitHub Dark",
  "author": "zF4ke",
  "description": "GitHub Dark Default's slate surfaces, blue accents and green actions, adapted for Ada.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "ada": ">=0.16.2 <0.17.0",
    "pluginApi": "^1.0.0"
  },
  "hosts": [
    "desktop"
  ],
  "dependencies": {},
  "conflicts": [],
  "after": [],
  "grants": [],
  "files": [],
  "contributes": {
    "themes": [
      {
        "id": "github-dark",
        "name": "GitHub Dark",
        "appearance": "dark",
        "tokens": {
          "--text-primary": "#e6edf3",
          "--text-body": "#e6edf3",
          "--text-muted": "#8b949e",
          "--text-placeholder": "#7d8590",
          "--surface-opaque": "#0d1117",
          "--surface-glass": "#0d1117f5",
          "--surface-composer": "#0d1117",
          "--surface-panel": "#0d1117",
          "--surface-row": "#0d1117",
          "--surface-row-hover": "#21262d",
          "--surface-ada-message": "#161b22",
          "--surface-section": "#161b22",
          "--surface-menu": "#161b22",
          "--surface-field": "#010409",
          "--border-divider": "#21262d",
          "--border-section": "#21262d",
          "--border-menu": "#30363d",
          "--selection-fill": "#388bfd26",
          "--selection-border": "#388bfd66",
          "--focus-ring": "#2f81f7",
          "--caret": "#e6edf3",
